# Hanzo IAM — OAuth2/OIDC via @hanzo/iam (PKCE; no client secret in browser).
# Defaults are baked into the app; only override to point at a different IAM.
# serverUrl auto-discovers /v1/iam/oauth/* from /.well-known/openid-configuration.
NEXT_PUBLIC_HANZO_IAM_URL=https://hanzo.id
NEXT_PUBLIC_HANZO_CLIENT_ID=hanzo-app
# redirectUri defaults to ${origin}/auth/callback; set only for non-browser builds.
# NEXT_PUBLIC_HANZO_REDIRECT_URI=http://localhost:3000/auth/callback

# Hanzo Telemetry — TWO planes, ONE client (@hanzo/event, wired in app/providers.tsx).
# Both vars below are NEXT_PUBLIC_*, i.e. inlined at BUILD time: setting them in the
# deploy env after the fact does nothing. See .github/workflows/deploy.yml (KMS).
#
# Plane 1 — the event stream: POST ${NEXT_PUBLIC_HANZO_API_URL}/v1/event
# NEXT_PUBLIC_HANZO_API_URL=https://api.hanzo.ai
#
# Publishable ingest key — write-only, safe to ship in the bundle. NOTE THE PREFIX:
# cloud matches `pk-` (hyphen, cloud.PublishablePrefix). A `pk_…` value is NOT
# recognized, is not treated as "presented" either, and so misfiles to the $public
# tenant instead of 403ing — it fails SILENTLY.
# Without this key, logged-out traffic still lands, but under the reserved $public
# tenant, where (a) our org cannot read it and (b) the anonymous allowlist stores
# ONLY pageview+error — every @hanzo/observe interaction ($click/$input/$change/
# $submit/$view) is dropped. On an all-anonymous marketing site that is the whole
# point of the key. Mint per org: POST /v1/ingest/keys
# NEXT_PUBLIC_HANZO_INGEST_KEY=pk-xxxxxxxxxxxx
#
# Plane 2 — the ERROR plane: a Sentry envelope to sentry.hanzo.ai. This does NOT
# ride the event stream; there is no server-side fan-out from /v1/event into Sentry.
# With no DSN the error plane is INERT and the dashboard gets nothing — that exact
# omission is why this site reported zero errors. Mint: POST /v1/sentry/projects
# NEXT_PUBLIC_HANZO_EVENT_DSN=https://<version>:<hmac>@sentry.hanzo.ai/v1/sentry/<projectId>

# Hanzo Commerce API
VITE_HANZO_API_URL=https://api.hanzo.ai

# Square Payment Processor (Primary)
VITE_SQUARE_APPLICATION_ID=sandbox-sq0idb-xxx
VITE_SQUARE_LOCATION_ID=your-location-id
# For production:
# VITE_SQUARE_APPLICATION_ID=sq0idp-xxx
# VITE_SQUARE_LOCATION_ID=your-production-location-id

# Crypto Payments
VITE_CRYPTO_DEPOSIT_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect (for RainbowKit)
VITE_WALLETCONNECT_PROJECT_ID=your-project-id

# Optional RPC Endpoints (defaults to llamarpc.com public RPCs)
# VITE_RPC_MAINNET=https://eth-mainnet.g.alchemy.com/v2/xxx
# VITE_RPC_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/xxx
# VITE_RPC_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/xxx
# VITE_RPC_OPTIMISM=https://opt-mainnet.g.alchemy.com/v2/xxx
# VITE_RPC_BASE=https://base-mainnet.g.alchemy.com/v2/xxx
# VITE_RPC_AVALANCHE=https://avalanche-mainnet.infura.io/v3/xxx
# VITE_RPC_BSC=https://bsc-dataseed.binance.org

# Optional: Enable additional payment processors
# VITE_STRIPE_ENABLED=false
# VITE_PAYPAL_ENABLED=false
