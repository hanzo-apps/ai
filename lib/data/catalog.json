  "tour": {
    "story": "One org, one afternoon: a spaceship shop that did not exist this morning.",
    "beats": [
      {
        "line": "Start with the models.",
        "method": "GET",
        "path": "/v1/models",
        "summary": "Returns the list of available models from the routing table."
      },
      {
        "line": "Blend them behind one route.",
        "method": "POST",
        "path": "/v1/ai/routes",
        "summary": "Create a model-route"
      },
      {
        "line": "Ask it something.",
        "method": "POST",
        "path": "/v1/chat/completions",
        "summary": "Implements the OpenAI-compatible chat completions API"
      },
      {
        "line": "Hand it your own tools.",
        "method": "POST",
        "path": "/v1/agent",
        "summary": "Run one tool-calling round against your org's own tools"
      },
      {
        "line": "Let it run code somewhere safe.",
        "method": "POST",
        "path": "/v1/sandboxes",
        "summary": "Lease a sandbox"
      },
      {
        "line": "Give it a memory.",
        "method": "POST",
        "path": "/v1/vector",
        "summary": "Provision a vector collection for your org"
      },
      {
        "line": "Put it in a channel.",
        "method": "GET",
        "path": "/v1/bot/connect",
        "summary": "The socket a bot node dials and holds open to become invokable."
      },
      {
        "line": "Build the shop a site.",
        "method": "POST",
        "path": "/v1/sites/deploy",
        "summary": "Deploys a caller-supplied file manifest — the deploy_site capability an agent calls — and answers with where it went live."
      },
      {
        "line": "Put it live.",
        "method": "POST",
        "path": "/v1/sites/{slug}/publish",
        "summary": "Promotes a build output into a new release AND goes live with it — create+activate in one call, which is the 99% path."
      },
      {
        "line": "Open the store.",
        "method": "POST",
        "path": "/v1/commerce/product/",
        "summary": "Create a product"
      },
      {
        "line": "Sell a spaceship.",
        "method": "POST",
        "path": "/v1/store/{storeid}/checkout/authorize",
        "summary": "Authorize a new order against a storefront, holding the funds — the checkout spelling"
      },
      {
        "line": "Watch what it cost.",
        "method": "GET",
        "path": "/v1/billing/usage",
        "summary": "Every billed call the caller's org made, attributed to a product"
      }
    ]
  }
}
