{
  "name": "@hanzo/site",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "version": "0.2.16",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node scripts/noindex.mjs && node scripts/canonical.mjs && node scripts/wellknown.mjs && node scripts/llms.mjs",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint .",
    "test": "playwright test",
    "gates": "playwright test --project=gates",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "gen:gui-css": "node scripts/gen-gui-css.mjs",
    "prebuild": "node scripts/gen-gui-css.mjs && node scripts/sync-mark.mjs && node scripts/sync-pricing.mjs && node scripts/sync-catalog.mjs && node scripts/sync-papers.mjs && node scripts/sync-blueprints.mjs && node scripts/sync-oss.mjs && node scripts/sync-pages.mjs",
    "predev": "node scripts/gen-gui-css.mjs",
    "sync:pricing": "node scripts/sync-pricing.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "sync:papers": "node scripts/sync-papers.mjs",
    "sync:oss": "node scripts/sync-oss.mjs",
    "sync:mark": "node scripts/sync-mark.mjs",
    "sync:pages": "node scripts/sync-pages.mjs",
    "audit:catalog": "node scripts/audit-catalog.mjs",
    "lint:design": "hanzo-design-lint components app lib"
  },
  "dependencies": {
    "@hanzo/ai": "^0.3.8",
    "@hanzo/appearance": "^0.1.6",
    "@hanzo/brand": "^1.4.6",
    "@hanzo/chat": "^1.0.3",
    "@hanzo/composer": "^0.1.3",
    "@hanzo/design": "^0.5.13",
    "@hanzo/event": "^0.3.28",
    "@hanzo/frame": "^0.1.0",
    "@hanzo/gui": "^8.1.1",
    "@hanzo/iam": "^0.21.13",
    "@hanzo/logo": "^1.0.20",
    "@hanzo/observe": "^0.1.7",
    "@hanzo/plans": "^1.4.16",
    "@hanzo/ui": "^8.0.111",
    "@hanzo/usage": ">=0.1.6",
    "@hanzo/voice": "^0.1.8",
    "@hanzogui/config": "^8.1.1",
    "@hanzogui/lucide-icons-2": "^8.1.1",
    "@hanzogui/next-theme": "^8.1.1",
    "@hanzogui/shell": "8.1.45",
    "@hanzogui/web": "^8.1.1",
    "@zenlm/models": "^1.0.4",
    "dompurify": "^3.4.13",
    "framer-motion": "^13.1.0",
    "lucide-react": "^0.462.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.2",
    "sonner": "^2.0.8",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.0.17",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^11.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "simple-icons": "^16.28.0",
    "tailwindcss": "^4.0.17",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "@react-native/normalize-colors": "0.83.2",
      "react-is": "18.3.1",
      "framer-motion": "13.1.0"
    }
  }
